<%# _post.html.erbと同じIDのTurbo Frameを設置 %>
<%= turbo_frame_tag dom_id(@post) do %>
<div class="card mb-3">
    <div class="card-header">投稿を編集</div>
    <div class="card-body">
        <%= form_with(model: [@theme, @post]) do |f| %>
        <%= render "posts/flash", object: f.object %>
        <div class="mb-3">
            <%= f.text_field :nickname, class: "form-control", placeholder: "ニックネーム" %>
        </div>
        <div class="mb-3">
            <%= f.text_area :content, class: "form-control" %>
        </div>
        <div class="d-flex justify-content-end">
            <%= f.submit "更新する", class: "btn btn-primary" %>
            <%= link_to "キャンセル", theme_posts_path(@theme), class: "btn btn-secondary ms-2" %>
        </div>
        <% end %>
    </div>
</div>
<% end %>