<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span class="d-block"><%= post.nickname ? post.nickname : "匿名さん" %></span>
        <span class="d-block"><%= time_ago_in_words(post.created_at) %></span>
    </div>
    <li class="card-body">
        <p class="card-text"><%= post.content %></p>
        <% if post.user && post.user == current_user  %>
        <%= link_to "削除する", [post.theme, post], class: "card-link", data: { "turbo-method": :delete, turbo_confirm: "削除してよろしいですか?" } %>
        <% end %>
    </li>
</div>