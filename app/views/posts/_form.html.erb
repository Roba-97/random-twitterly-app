<%= form_with(model: @post, url: theme_posts_path, class: "mt-4 mb-5") do |f| %>
<%= render "posts/flash", object: f.object %>

<%= hidden_field_tag :theme_id, @theme.id %>

<%= f.label :nickname, "ニックネーム", class: "mb-2" %>
<%= f.text_field :nickname, class: 'form-control w-50 mb-2' %>

<%= f.label :content, "投稿内容", class: "mb-2" %>
<%= f.text_area :content, class: 'form-control' %>

<%= f.submit "投稿する" , class: "btn btn-primary mt-2" %>
<% end %>